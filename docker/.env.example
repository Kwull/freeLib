# freeLib Docker environment example
# Copy this to .env and adjust values as needed

# Admin password for the web interface
FREELIB_ADMIN_PASSWORD=changeme

# Optional: comma-separated list of INPX files to import on startup
# FREELIB_AUTOIMPORT=/books/library.inpx

# Optional: user and group ids the server runs as (default 1000); use `id -u` / `id -g`
# PUID=1000
# PGID=1000
